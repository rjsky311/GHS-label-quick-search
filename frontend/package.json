{
  "name": "frontend",
  "version": "1.10.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "lint": "eslint src scripts",
    "build": "vite build",
    "preview": "vite preview",
    "qa:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "qa:github-resource": "node scripts/check-github-resource-usage.mjs",
    "qa:h-code-coverage": "python ../backend/scripts/audit_h_code_coverage.py --fail-on-gaps",
    "qa:p-code-coverage": "python ../backend/scripts/audit_p_code_coverage.py --fail-on-gaps",
    "qa:workbench": "node scripts/check-experiment-notebook-workbench.mjs",
    "test:docs": "node scripts/check-docs-drift.mjs",
    "test:i18n": "node scripts/check-i18n-parity.mjs",
    "test:print-contract": "jest --runInBand printContentPolicy.test.js printOutputContract.test.js printAcceptanceMatrix.test.js printOutputPlanner.test.js printFitEngine.test.js printBatchPlanner.test.js printHandoffPreflight.test.js printLabels.test.js printQaMatrixReport.test.js",
    "qa:print-report": "jest --runInBand printQaMatrixReport.test.js --silent=false",
    "qa:print-pdf": "node scripts/check-print-pdf-artifacts.mjs",
    "qa:physical-print-plan": "node scripts/generate-physical-print-plan.mjs",
    "qa:inventory-print-samples": "node scripts/generate-inventory-print-samples.mjs",
    "qa:inventory-print-evidence": "node scripts/generate-inventory-print-evidence.mjs",
    "test:inventory-print-samples": "node --test scripts/__tests__/inventory-print-sampling.test.mjs",
    "test:qa-scripts": "node --test scripts/__tests__/frontend-scaffold-boundary.test.mjs scripts/__tests__/inventory-print-sampling.test.mjs scripts/__tests__/print-maintainability-boundary.test.mjs scripts/__tests__/print-pdf-thresholds.test.mjs scripts/__tests__/production-batch-print-search-gate.test.mjs scripts/__tests__/production-expected-sha.test.mjs scripts/__tests__/production-qa-trust.test.mjs scripts/__tests__/production-summary-gates.test.mjs scripts/__tests__/workbench-theme-gate.test.mjs",
    "qa:production-bundle": "node scripts/check-production-print-bundle.mjs",
    "qa:zeabur-deployment": "node scripts/check-zeabur-deployment-freshness.mjs",
    "qa:production-health": "node scripts/check-production-health.mjs",
    "qa:production-pdf-canary": "node scripts/check-production-pdf-canary.mjs",
    "qa:production-handoff": "node scripts/check-production-print-handoff.mjs",
    "qa:production-search-ui": "node scripts/check-production-search-ui.mjs",
    "qa:production-batch-print": "node scripts/check-production-batch-print.mjs",
    "qa:production-lab-ready-batch": "node scripts/check-production-batch-print.mjs --fixture=lab-ready",
    "qa:production-smoke": "node scripts/run-production-print-smoke.mjs",
    "qa:production-product": "node scripts/run-production-product-qa.mjs",
    "qa:production-primary": "node scripts/run-production-print-layer.mjs primary",
    "qa:production-compact": "node scripts/run-production-print-layer.mjs compact",
    "qa:production-multi-chemical": "node scripts/run-production-print-layer.mjs multi-chemical",
    "qa:production-prepared": "node scripts/check-production-prepared-print.mjs",
    "qa:production-summary": "node scripts/summarize-production-print-qa.mjs",
    "qa:production-print": "node scripts/run-production-print-qa.mjs",
    "test": "jest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "9.23.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright-core": "^1.59.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.2",
    "zeabur": "0.20.0"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@11.6.2"
}
