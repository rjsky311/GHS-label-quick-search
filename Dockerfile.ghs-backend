# Canonical build recipe for the ghs-backend container service.
#
# Zeabur's inline specification and a future Railway service should both stay
# aligned with this file so Chromium, CJK fonts, and PDF rendering are never
# silently omitted. Keep backend/Dockerfile in sync for local builds.
FROM python:3.11-slim
LABEL "language"="python"
LABEL "framework"="fastapi"

ARG BUILD_GIT_SHA=""
ENV BUILD_GIT_SHA=${BUILD_GIT_SHA}
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PORT=8001

WORKDIR /app

# Install Python dependencies and the Chromium runtime before switching to the
# non-root app user so the browser cache stays readable at runtime.
# COPY paths are relative to the repo root (the build context).
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium \
    && apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright

# Map the print stylesheet's CJK families to Noto Sans CJK TC so label PDFs
# use Taiwan-standard glyphs instead of the WenQuanYi fallback that ships
# with Chromium's dependency set.
COPY backend/fonts/local.conf /etc/fonts/local.conf

# Copy application code
COPY backend/ .

# Create the non-root user and give it ownership only of the default ephemeral
# pilot-store directory. Application code remains root-owned and read-only.
RUN adduser --disabled-password --gecos '' appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app/data
USER appuser

# Expose port
EXPOSE 8001

# Run the application
CMD ["sh", "-c", "exec uvicorn server:app --host 0.0.0.0 --port \"${PORT:-8001}\""]
